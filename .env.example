# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (canonical links, sitemap, Open Graph, Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://www.exempel.se

# Live chat: URL of your chat provider (hosted chat page or widget link).
# Leave empty to send the "Start chat" button to the other contact channels.
NEXT_PUBLIC_CHAT_URL=

# Photos from Pexels (server-side only). Without a key, illustrated placeholders are shown.
PEXELS_API_KEY=

# Card payments via Stripe Checkout (optional). Without a key, card payment is hidden
# behind a friendly "use Swish or bankgiro" message.
STRIPE_SECRET_KEY=

# Forms (volunteer, booking, partner) are POSTed as JSON to this URL
# (Zapier, Make, Slack workflow, CRM…). Optional shared secret is sent as X-Webhook-Secret.
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=

# Cookieless statistics with Plausible. Only loads after consent, never on support pages.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
